// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models
// Docs: https://authjs.dev/getting-started/adapters/prisma

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]
  cardGenerations CardGeneration[]
  sharedGenerations SharedGeneration[]
  drillSheetGenerations DrillSheetGeneration[]
  sharedDrillSheets SharedDrillSheet[]
  betaFeedback  BetaFeedback[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model CardGeneration {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // PFEQ metadata
  cycle       String
  grade       String
  subject     String
  notion      String
  subNotions  String // JSON string array of sub-notion keys

  // Generation settings
  cardCount   Int      @map("card_count")
  theme       String?  // Theme identifier
  fontFamily  String?  @map("font_family")

  // Generated cards data (JSON)
  cards       Json     // Stores the array of generated cards

  // Text customizations
  textPositions     String? // JSON object of text positions per card
  editedTexts       String? // JSON object of edited texts per card

  // Font settings
  fontSize          Int?
  isBold            Boolean?
  isItalic          Boolean?
  isUnderline       Boolean?
  textAlign         String?
  textBackground    Int?

  // Illustration settings
  selectedCharacter String?
  selectedMood      String?
  showIllustrations Boolean?
  illustrationScale Int?
  illustrationColor String?
  transparentBackground Boolean?
  illustrationTransforms String? // JSON object of illustration transforms per card

  // Advanced theme settings
  themeType              String?
  selectedAdvancedTheme  Int?
  selectedDalleTheme     Int?

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([createdAt])
  @@map("card_generations")
}

model SharedGeneration {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // User info for display
  authorName  String?  @map("author_name")
  authorEmail String?  @map("author_email")

  // PFEQ metadata
  cycle       String
  grade       String
  subject     String
  notion      String
  subNotions  String // JSON string array of sub-notion keys

  // Generation settings
  cardCount   Int      @map("card_count")
  theme       String?  // Theme identifier
  fontFamily  String?  @map("font_family")

  // Generated cards data (JSON)
  cards       Json     // Stores the array of generated cards

  // Text customizations
  textPositions     String? // JSON object of text positions per card
  editedTexts       String? // JSON object of edited texts per card

  // Font settings
  fontSize          Int?
  isBold            Boolean?
  isItalic          Boolean?
  isUnderline       Boolean?
  textAlign         String?
  textBackground    Int?

  // Illustration settings
  selectedCharacter String?
  selectedMood      String?
  showIllustrations Boolean?
  illustrationScale Int?
  illustrationColor String?
  transparentBackground Boolean?
  illustrationTransforms String? // JSON object of illustration transforms per card

  // Advanced theme settings
  themeType              String?
  selectedAdvancedTheme  Int?
  selectedDalleTheme     Int?

  // Sharing metadata
  views       Int      @default(0)
  copies      Int      @default(0)

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  sharedAt    DateTime @default(now()) @map("shared_at")

  @@index([userId])
  @@index([sharedAt])
  @@index([subject])
  @@index([grade])
  @@map("shared_generations")
}

// Drill Sheet Generation Models

model DrillSheetGeneration {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // PFEQ metadata (same as task cards)
  cycle       String
  grade       String
  subject     String
  notion      String
  subNotions  String   // JSON stringified array

  // Drill sheet specific settings
  exerciseCount     Int      @map("exercise_count")      // 10-30 exercises
  difficulty        String?  @default("uniform")         // 'uniform', 'progressive', 'mixed'
  includeAnswerKey  Boolean  @default(true) @map("include_answer_key")

  // Styling
  theme             String?  @default("simple")          // 'simple', 'colorful', 'minimal'
  fontFamily        String?  @map("font_family")
  fontSize          Int?     @default(12)
  headerStyle       String?  @map("header_style")        // JSON: { color, bold, etc. }

  // THE CRITICAL FIELD - Raw drill sheet data
  exercises   Json     // Array of exercise objects

  // Optional customization
  customTitle         String?  @map("custom_title")
  customInstructions  String?  @map("custom_instructions")
  showDifficulty      Boolean? @default(false) @map("show_difficulty")

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([createdAt])
  @@index([subject])
  @@index([notion])
  @@map("drill_sheet_generations")
}

model SharedDrillSheet {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // User info for display
  authorName  String?  @map("author_name")
  authorEmail String?  @map("author_email")

  // PFEQ metadata
  cycle       String
  grade       String
  subject     String
  notion      String
  subNotions  String   // JSON stringified array

  // Drill sheet specific settings
  exerciseCount     Int      @map("exercise_count")
  difficulty        String?  @default("uniform")
  includeAnswerKey  Boolean  @default(true) @map("include_answer_key")

  // Styling
  theme             String?  @default("simple")
  fontFamily        String?  @map("font_family")
  fontSize          Int?     @default(12)
  headerStyle       String?  @map("header_style")

  // Generated drill sheet data
  exercises   Json     // Array of exercise objects

  // Optional customization
  customTitle         String?  @map("custom_title")
  customInstructions  String?  @map("custom_instructions")
  showDifficulty      Boolean? @default(false) @map("show_difficulty")

  // Sharing metadata
  views       Int      @default(0)
  copies      Int      @default(0)

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  sharedAt    DateTime @default(now()) @map("shared_at")

  @@index([userId])
  @@index([sharedAt])
  @@index([subject])
  @@index([grade])
  @@index([views])
  @@map("shared_drill_sheets")
}

model BetaFeedback {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Feedback content
  feedback    String   @db.Text

  // Context information
  userAgent   String?  @map("user_agent")
  currentPage String?  @map("current_page")

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("beta_feedback")
}
